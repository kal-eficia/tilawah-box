[Unit]
Description=Tilawah Box
After=network-online.target sound.target
Wants=network-online.target

[Service]
User=pi
WorkingDirectory=/home/pi/tilawah-box
ExecStart=/home/pi/tilawah-box/.venv/bin/python -m tilawah --config /home/pi/tilawah-box/config.json run
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
